<Window x:Class="Hekki.UI.SprintNewReg"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Hekki.UI"
        mc:Ignorable="d"
        Title="SprintNewReg" Height="450" Width="800">
    <Grid>
        <Button x:Name="DoQual1" Content="Распределить Квалу 1" HorizontalAlignment="Left" Margin="57,60,0,0" VerticalAlignment="Top" Height="72" Width="143"/>
        <Button x:Name="DoHeat1" Content="Распределить 1 хит" HorizontalAlignment="Left" Margin="231,60,0,0" VerticalAlignment="Top" Height="72" Width="143"/>
        <Button x:Name="DoQual2" Content="Распределить Квалу 2" HorizontalAlignment="Left" Margin="409,60,0,0" VerticalAlignment="Top" Height="72" Width="143"/>
        <Button x:Name="DoHeat2" Content="Распределить 1 хит" HorizontalAlignment="Left" Margin="586,60,0,0" VerticalAlignment="Top" Height="72" Width="143"/>
        <Button x:Name="DoFinal" Content="Распределить Финал" HorizontalAlignment="Left" Margin="588,156,0,0" VerticalAlignment="Top" Height="72" Width="144"/>
        <Button x:Name="RebuildPilots" HorizontalAlignment="Left" Margin="297,256,0,0" VerticalAlignment="Top" Height="68" Width="98">
            <TextBlock Text="Пересобрать пилотов" TextWrapping="Wrap" TextAlignment="Center"/>
        </Button>
        <Button HorizontalAlignment="Left" Margin="297,345,0,0" VerticalAlignment="Top" Height="68" Width="98">
            <TextBlock x:Name="DeleteKartsFromLastRace" Text="Удалить карты с последнего хита" TextWrapping="Wrap" TextAlignment="Center"/>
        </Button>
        <Button x:Name="SortTimeDead" HorizontalAlignment="Left" Margin="446,345,0,0" VerticalAlignment="Top" Height="68" Width="97">
            <TextBlock Text="Сортировать времена Дед" TextWrapping="Wrap" TextAlignment="Center"/>
        </Button>
        <Button x:Name="ReadTimes" HorizontalAlignment="Left" Margin="565,345,0,0" VerticalAlignment="Top" Height="68" Width="97">
            <TextBlock Text="Перенести время в общую таблицу" TextWrapping="Wrap" TextAlignment="Center"/>
        </Button>
        <Button x:Name="SortTimes" HorizontalAlignment="Left" Margin="683,345,0,0" VerticalAlignment="Top" Height="68" Width="97">
            <TextBlock Text="Сортировать времена" TextWrapping="Wrap" TextAlignment="Center"/>
        </Button>
        <Button x:Name="ReadScores" HorizontalAlignment="Left" Margin="564,258,0,0" VerticalAlignment="Top" Height="68" Width="98">
            <TextBlock Text="Перенести балы в общую таблицу" TextWrapping="Wrap" TextAlignment="Center"/>
        </Button>

        <Button x:Name="SortScores" HorizontalAlignment="Left" Margin="683,258,0,0" VerticalAlignment="Top" Height="68" Width="97">
            <TextBlock Text="Сортировать общую таблицу по балам" TextWrapping="Wrap" TextAlignment="Center"/>
        </Button>
        <Button x:Name="DoSemiFinal" HorizontalAlignment="Left" Margin="409,156,0,0" VerticalAlignment="Top" Height="72" Width="144">
            <TextBlock Text="Распределить Полуфинал" TextWrapping="Wrap" TextAlignment="Center"/>
        </Button>
        <Button x:Name="Clear" Content="Очистить" HorizontalAlignment="Left" Margin="180,368,0,0" VerticalAlignment="Top" Height="45" Width="96"/>
        <RichTextBox x:Name="numbersOfKarts" Margin="57,236,647,21">
            <FlowDocument>
                <Paragraph>
                    <Run/>
                </Paragraph>
            </FlowDocument>
        </RichTextBox>
    </Grid>
</Window>
