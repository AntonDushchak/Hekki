<UserControl x:Class="Hekki.UI.Views.CreateRegulation.CreateRegulationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Hekki.UI.Views.CreateRegulation"
             xmlns:converters="clr-namespace:Hekki.UI.Converters"
             xmlns:shared="clr-namespace:Hekki.UI.Views.Shared.Controls"
             xmlns:vm="clr-namespace:Hekki.UI.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1240"
             PreviewMouseWheel="OnPreviewMouseWheel">
    
    <UserControl.Resources>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <converters:IntToVisibilityConverter x:Key="IntToVisibilityConverter"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid HorizontalAlignment="Stretch"
              MaxWidth="1200"
              Margin="40,0">
        
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Row="0" Grid.ColumnSpan="3" Margin="0, 0, 0,30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="{DynamicResource m_RegulationName}" 
                       Margin="10,10,10,10" 
                       Grid.Row="0" Grid.Column="0" FontSize="16"/>
            
            <TextBox x:Name="NameTextBox" 
                     TextWrapping="Wrap" 
                     Text="{Binding RegulationName, UpdateSourceTrigger=PropertyChanged}" 
                     Margin="10,0,10,0"
                     MinWidth="140" MinHeight="35"
                     Grid.Row="1" Grid.Column="0"/>
        </Grid>


        <Border Grid.Row="1" 
                Grid.ColumnSpan="3" 
                x:Name="HeatsGrid" 
                CornerRadius="5" 
                Background="{DynamicResource Brush.SurfaceLow}" 
                Margin="0,0,0,30"
                Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="{DynamicResource m_Heats}" 
                           HorizontalAlignment="Left" 
                           Margin="0,0,10,10" 
                           VerticalAlignment="Top"
                           Grid.Row="0" FontSize="18" FontWeight="SemiBold"/>
 
                <ListBox ItemsSource="{Binding Heats}" 
                         SelectedItem="{Binding SelectedHeat}" 
                         Grid.Row="1"
                         Grid.ColumnSpan="2"
                         BorderThickness="0"
                         Background="Transparent"
                         Margin="0,0,0,15"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         MinHeight="50">

                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="0,0,8,0"/>
                            <Setter Property="Padding" Value="15,8"/>
                            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceHigh}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>

                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="InnerBorder" 
                                                CornerRadius="4" 
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="1"
                                                Padding="{TemplateBinding Padding}"
                                                SnapsToDevicePixels="True">
                                            <ContentPresenter Content="{Binding Name}" 
                                                              HorizontalAlignment="Center" 
                                                              VerticalAlignment="Center"/>
                                        </Border>

                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="InnerBorder" Property="Background" Value="{DynamicResource Brush.UIElement}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="InnerBorder" Property="Background" Value="{DynamicResource Brush.TextDisabled}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <StackPanel Grid.Row="2" 
                            Orientation="Horizontal" 
                            HorizontalAlignment="Left">
                    <Button x:Name="AddHeatButton"
                            Content="{DynamicResource m_AddHeat}" 
                            FontSize="18" 
                            MinWidth="55" MinHeight="30"
                            Command="{Binding AddHeatCommand}"
                            Background="{DynamicResource Brush.SurfaceHigh}"
                            Margin="0,0,10,0"/>
                    <Button x:Name="DeleteHeatButton"
                            Content="{DynamicResource m_Delete}" 
                            FontSize="18" 
                            MinWidth="55" MinHeight="30"
                            Command="{Binding DeleteHeatCommand}"
                            Background="{DynamicResource Brush.SurfaceHigh}"/>
                </StackPanel>
            </Grid> 
        </Border>


        <shared:HeatSettingsEditor Grid.Row="2"
                                   Grid.ColumnSpan="3"
                                   DataContext="{Binding MethodSettingsEditor}"/>

        <Grid Grid.Row="3" Grid.ColumnSpan="3" Margin="0,30,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" 
                        Command="{Binding CancelCommand}" 
                        Content="{DynamicResource m_Cancel}" 
                        FontSize="18" 
                        MinWidth="80" MinHeight="30"
                        Margin="0,0,10,0"/>
                <Button x:Name="SaveButton" 
                        Command="{Binding SaveCommand}" 
                        Content="{DynamicResource m_Save}" 
                        FontSize="18" 
                        MinWidth="80" MinHeight="30"/>
            </StackPanel>
        </Grid>


        </Grid>
    </ScrollViewer>
</UserControl>
