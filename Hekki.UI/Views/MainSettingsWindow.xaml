<Window x:Class="Hekki.UI.Views.MainSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource m_Settings}"
        Width="720"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Background="{DynamicResource Brush.Base}">
    <Border Padding="30"
            Background="{DynamicResource Brush.Base}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0"
                       Grid.ColumnSpan="3"
                       Margin="0,0,0,20"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.TextPrimary}"
                       Text="{DynamicResource m_Settings}" />

            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,15,20">
                <TextBlock Margin="0,0,0,5" Text="{DynamicResource m_Language}" />
                <ComboBox ItemsSource="{Binding Languages}"
                          SelectedItem="{Binding SelectedLanguage}"
                          MinHeight="30" />
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,15,20">
                <TextBlock Margin="0,0,0,5" Text="{DynamicResource m_Theme}" />
                <ComboBox ItemsSource="{Binding Themes}"
                          SelectedItem="{Binding SelectedTheme}"
                          MinHeight="30" />
            </StackPanel>

            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,15,20">
                <TextBlock Margin="0,0,0,5" Text="{DynamicResource m_KartNumbers}" />
                <ListBox ItemsSource="{Binding KartNumbers}"
                         SelectedItem="{Binding SelectedKartNumber}"
                         Height="180" />
                <DockPanel Margin="0,8,0,0">
                    <Button DockPanel.Dock="Right" Width="36" Margin="8,0,0,0" Content="+" Command="{Binding AddKartNumberCommand}" />
                    <TextBox Text="{Binding NewKartNumber, UpdateSourceTrigger=PropertyChanged}" />
                </DockPanel>
                <Button Margin="0,8,0,0" Content="{DynamicResource m_Delete}" Command="{Binding RemoveKartNumberCommand}" />
            </StackPanel>

            <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,15,20">
                <TextBlock Margin="0,0,0,5" Text="{DynamicResource m_Teams}" />
                <ListBox ItemsSource="{Binding Teams}"
                         SelectedItem="{Binding SelectedTeam}"
                         Height="180" />
                <DockPanel Margin="0,8,0,0">
                    <Button DockPanel.Dock="Right" Width="36" Margin="8,0,0,0" Content="+" Command="{Binding AddTeamCommand}" />
                    <TextBox Text="{Binding NewTeam, UpdateSourceTrigger=PropertyChanged}" />
                </DockPanel>
                <Button Margin="0,8,0,0" Content="{DynamicResource m_Delete}" Command="{Binding RemoveTeamCommand}" />
            </StackPanel>

            <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,20">
                <TextBlock Margin="0,0,0,5" Text="{DynamicResource m_Leagues}" />
                <ListBox ItemsSource="{Binding Leagues}"
                         SelectedItem="{Binding SelectedLeague}"
                         Height="180" />
                <DockPanel Margin="0,8,0,0">
                    <Button DockPanel.Dock="Right" Width="36" Margin="8,0,0,0" Content="+" Command="{Binding AddLeagueCommand}" />
                    <TextBox Text="{Binding NewLeague, UpdateSourceTrigger=PropertyChanged}" />
                </DockPanel>
                <Button Margin="0,8,0,0" Content="{DynamicResource m_Delete}" Command="{Binding RemoveLeagueCommand}" />
            </StackPanel>

            <StackPanel Grid.Row="4"
                        Grid.ColumnSpan="3"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <Button MinWidth="80" Margin="0,0,10,0" Content="{DynamicResource m_Cancel}" Command="{Binding CancelCommand}" />
                <Button MinWidth="80" Content="{DynamicResource m_Save}" Command="{Binding SaveCommand}" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
