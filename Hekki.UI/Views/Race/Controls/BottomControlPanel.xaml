<UserControl x:Class="Hekki.UI.Views.Race.Controls.BottomControlPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:Hekki.UI.ViewModels"
             mc:Ignorable="d"
             x:Name="Root"
             d:DesignHeight="120" d:DesignWidth="800">

    <UserControl.Resources>
        <Storyboard x:Key="ShowPanelStoryboard">
            <DoubleAnimation Storyboard.TargetName="PanelTransform"
                           Storyboard.TargetProperty="Y"
                           To="0"
                           Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Key="HidePanelStoryboard">
            <DoubleAnimation Storyboard.TargetName="PanelTransform"
                           Storyboard.TargetProperty="Y"
                           To="80"
                           Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </UserControl.Resources>

    <Grid VerticalAlignment="Bottom" 
          HorizontalAlignment="Stretch">

        <Grid.RenderTransform>
            <TranslateTransform x:Name="PanelTransform" Y="80"/>
        </Grid.RenderTransform>

        <!-- Panel background with shadow -->
        <Border Background="{DynamicResource Brush.SurfaceLow}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,1,0,0"
                CornerRadius="12,12,0,0">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="0" 
                                BlurRadius="20" 
                                Opacity="0.2"
                                Color="Black"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Handle/indicator for opening panel -->
                <Border Grid.Row="0" 
                        Background="Transparent"
                        Cursor="Hand"
                        MouseLeftButtonDown="Handle_Click">
                    <Grid>
                        <Rectangle Width="60" 
                                 Height="4" 
                                 RadiusX="2" 
                                 RadiusY="2"
                                 Fill="{DynamicResource Brush.Border}"
                                 VerticalAlignment="Center"
                                 HorizontalAlignment="Center"
                                 Margin="0,8,0,0"/>

                        <TextBlock Text=""
                                 FontSize="14"
                                 FontWeight="SemiBold"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Margin="0,0,0,0"
                                 Foreground="{DynamicResource Brush.TextSecondary}"/>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1"
                            HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Disabled"
                            Padding="20,10,20,20">
                    <ItemsControl ItemsSource="{Binding HeatsTable.Heats}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" 
                                          HorizontalAlignment="Center"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:HeatViewModel}">
                                <Button x:Name="HeatButton"
                                      Margin="5,0"
                                      Padding="20,12"
                                      MinWidth="100"
                                      Background="{DynamicResource Brush.SurfaceLow}"
                                      BorderBrush="{DynamicResource Brush.Border}"
                                      BorderThickness="1"
                                      Cursor="Hand"
                                      Click="HeatButton_Click"
                                      Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                  BorderBrush="{TemplateBinding BorderBrush}"
                                                  BorderThickness="{TemplateBinding BorderThickness}"
                                                  CornerRadius="8"
                                                  Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>

                                    <StackPanel Orientation="Vertical" 
                                              HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding Name}"
                                                 FontSize="14"
                                                 FontWeight="SemiBold"
                                                 TextAlignment="Center"
                                                 Foreground="{DynamicResource Brush.TextPrimary}"/>

                                        <TextBlock FontSize="11"
                                                 TextAlignment="Center"
                                                 Margin="0,4,0,0"
                                                 Foreground="{DynamicResource Brush.TextSecondary}">
                                            <Run Text="Груп: "/>
                                            <Run Text="{Binding GroupCount, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="{DynamicResource m_EditHeat}"
                                                    Command="{Binding PlacementTarget.Tag.HeatsTable.EditHeatCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                    CommandParameter="{Binding}">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="✏️" FontSize="14"/>
                                                </MenuItem.Icon>
                                            </MenuItem>

                                            <MenuItem Header="{DynamicResource m_AssignGroupsAndNumbers}"
                                                    Command="{Binding PlacementTarget.Tag.HeatsTable.AssignGroupsAndNumbersCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                    CommandParameter="{Binding}">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="" FontSize="14"/>
                                                </MenuItem.Icon>
                                            </MenuItem>

                                            <Separator/>

                                            <MenuItem Header="{DynamicResource m_DeleteHeat}"
                                                    Command="{Binding PlacementTarget.Tag.HeatsTable.DeleteHeatCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                    CommandParameter="{Binding}">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="🗑️" FontSize="14"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Button.ContextMenu>

                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceLow}"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource Brush.Primary}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
