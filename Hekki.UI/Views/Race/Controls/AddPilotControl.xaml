<UserControl x:Class="Hekki.UI.Views.Race.Controls.AddPilotControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Hekki.UI.Views.Race.Controls"
             xmlns:vm="clr-namespace:Hekki.UI.ViewModels"
             xmlns:race="clr-namespace:Hekki.UI.ViewModels.Race"
             mc:Ignorable="d"
             d:DesignHeight="60" d:DesignWidth="400">
    <Grid>
        <TextBox x:Name="SearchTextBox"
                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                 PreviewKeyDown="SearchTextBox_PreviewKeyDown"
                 VerticalContentAlignment="Center"
                 MinHeight="40"
                 Padding="10,0"/>

        <Popup x:Name="SuggestionsPopup"
               IsOpen="{Binding IsPopupOpen, Mode=TwoWay}"
               PlacementTarget="{Binding ElementName=SearchTextBox}"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True"
               Width="{Binding ElementName=SearchTextBox, Path=ActualWidth}"
               MaxHeight="200">
            <ListBox x:Name="SuggestionsList"
                     ItemsSource="{Binding Suggestions}"
                     PreviewKeyDown="SuggestionsList_PreviewKeyDown"
                     Background="{DynamicResource Brush.SurfaceHigh}"
                     BorderBrush="{DynamicResource Brush.UIElement}"
                     BorderThickness="1"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.Resources>
                    <DataTemplate DataType="{x:Type vm:PilotViewModel}">
                        <TextBlock Text="{Binding FullName}"
                                   FontWeight="SemiBold"
                                   Margin="5"/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type race:NewPilotSuggestion}">
                        <TextBlock Margin="5" FontStyle="Italic">
                            <Run Text="+"/>
                            <Run Text="{DynamicResource m_NewPilot}"/>
                            <Run Text="{Binding FullName, Mode=OneWay}" FontWeight="SemiBold"/>
                        </TextBlock>
                    </DataTemplate>
                </ListBox.Resources>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="8,4"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <EventSetter Event="MouseLeftButtonUp" Handler="SuggestionItem_MouseLeftButtonUp"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Brush.SurfaceMid}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Popup>
    </Grid>
</UserControl>
