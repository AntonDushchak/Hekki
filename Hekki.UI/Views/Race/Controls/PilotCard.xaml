<UserControl x:Class="Hekki.UI.Views.Race.Controls.PilotCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Hekki.UI.Views.Race.Controls"
             mc:Ignorable="d"
             d:DesignHeight="80" d:DesignWidth="1000">
    <Border Background="White"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="1"
            CornerRadius="8">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Category vertical bar -->
            <Border Grid.Column="0"
                    Width="30"
                    Background="#4A90E2"
                    CornerRadius="8,0,0,8">
                <TextBlock Text="{Binding Participant.League}"
                           Foreground="White"
                           FontWeight="Bold"
                           FontSize="12"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center">
                    <TextBlock.LayoutTransform>
                        <RotateTransform Angle="-90"/>
                    </TextBlock.LayoutTransform>
                </TextBlock>
            </Border>

            <!-- Photo and numbers section -->
            <StackPanel Grid.Column="1"
                        Orientation="Vertical"
                        VerticalAlignment="Center"
                        Margin="15,10">
                <!-- Photo placeholder -->
                <Border Width="50"
                        Height="50"
                        Background="{DynamicResource Brush.SurfaceMid}"
                        CornerRadius="4"
                        Margin="0,0,0,5">
                    <TextBlock Text="👤"
                               FontSize="24"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.TextHint}"/>
                </Border>

                <!-- Kart numbers below name -->
                <TextBlock Text="{Binding KartNumbersDisplayText}"
                           HorizontalAlignment="Center"
                           FontSize="11"
                           Foreground="{DynamicResource Brush.TextSecondary}"/>
            </StackPanel>

            <!-- Name -->
            <TextBlock Grid.Column="2"
                       Text="{Binding Participant.Name}"
                       VerticalAlignment="Center"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Margin="15,0,20,0"
                       MinWidth="150"/>
        </Grid>
    </Border>
</UserControl>
