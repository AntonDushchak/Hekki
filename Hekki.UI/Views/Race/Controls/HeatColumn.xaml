<UserControl x:Class="Hekki.UI.Views.Race.Controls.HeatColumn"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Hekki.UI.Views.Race.Controls"
             mc:Ignorable="d"
             xmlns:vm="clr-namespace:Hekki.UI.ViewModels">
    
    <StackPanel MaxWidth="650">
        <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,15"/>

        <ItemsControl ItemsSource="{Binding Groups}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Vertical"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:HeatGroupViewModel}">
                    <local:HeatGroupCard Margin="0,0,0,12"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
