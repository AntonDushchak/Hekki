<UserControl x:Class="Hekki.UI.Views.Race.Controls.TotalTableRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Hekki.UI.Views.Race.Controls"
             xmlns:converters="clr-namespace:Hekki.UI.Converters"
             xmlns:vm="clr-namespace:Hekki.UI.ViewModels"
             mc:Ignorable="d">

    <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="15">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

            <!-- Static pilot columns — SharedSizeGroup matches TotalTable header -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition SharedSizeGroup="col_side" Width="Auto"/>
                    <ColumnDefinition SharedSizeGroup="col_photo" Width="Auto"/>
                    <ColumnDefinition SharedSizeGroup="col_name" Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- League / Team vertical bar -->
                <Border Grid.Column="0"
                        Width="30" MinHeight="60"
                        Background="#4A90E2"
                        CornerRadius="8,0,0,8"
                        Margin="0,0,8,0">
                    <TextBlock Text="{Binding Participant.League}"
                               Foreground="White" FontWeight="Bold" FontSize="12"
                               VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock.LayoutTransform>
                            <RotateTransform Angle="-90"/>
                        </TextBlock.LayoutTransform>
                    </TextBlock>
                </Border>

                <!-- Photo + kart numbers -->
                <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Border Width="50" Height="50"
                            Background="{DynamicResource Brush.SurfaceMid}"
                            CornerRadius="4" Margin="0,0,0,4">
                        <TextBlock Text="👤" FontSize="24"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.TextHint}"/>
                    </Border>
                    <TextBlock Text="{Binding KartNumbersDisplayText}"
                               HorizontalAlignment="Center" FontSize="11"
                               Foreground="{DynamicResource Brush.TextSecondary}"/>
                </StackPanel>

                <!-- Name -->
                <TextBlock Grid.Column="2"
                           Text="{Binding Participant.Name}"
                           VerticalAlignment="Center"
                           FontSize="16" FontWeight="SemiBold"
                           Margin="0,0,16,0"/>
            </Grid>

            <!-- Dynamic result cells -->
            <ItemsControl ItemsSource="{Binding Cells}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:CellViewModel}">
                        <TextBlock Text="{Binding Value}" TextAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Width" Value="{DynamicResource TotalTable.HeatColumnWidth}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Column.Type}" Value="{x:Static vm:ColumnType.TotalTime}">
                                            <Setter Property="Width" Value="{DynamicResource TotalTable.TotalColumnWidth}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Column.Type}" Value="{x:Static vm:ColumnType.TotalScore}">
                                            <Setter Property="Width" Value="{DynamicResource TotalTable.TotalColumnWidth}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </Border>
</UserControl>
