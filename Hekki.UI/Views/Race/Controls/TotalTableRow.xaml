<UserControl x:Class="Hekki.UI.Views.Race.Controls.TotalTableRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:table="clr-namespace:Hekki.UI.Views.Shared.Table">

    <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border Tag="DragHandle"
                    Width="24"
                    Background="Transparent"
                    Cursor="SizeAll">
                <TextBlock Text="≡"
                           FontSize="16"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.Border}"/>
            </Border>

            <table:TableRow/>
        </StackPanel>
    </Border>
</UserControl>
