<UserControl x:Class="Hekki.UI.Views.Race.Controls.TotalTable"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Hekki.UI.Views.Race.Controls"
             xmlns:converters="clr-namespace:Hekki.UI.Converters"
             mc:Ignorable="d"
             xmlns:vm="clr-namespace:Hekki.UI.ViewModels"
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <converters:ResourceKeyToStringConverter x:Key="ResourceKeyToStringConverter"/>
        <converters:ColumnHeaderConverter x:Key="ColumnHeaderConverter"/>
    </UserControl.Resources>

    <Border Background="White" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="12">
        <!-- Outer: horizontal scroll moves header + rows together -->
        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header row — populated by code-behind with Thumbs for resize -->
                <Border Grid.Row="0"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="0,0,0,1"
                        Padding="15">
                    <StackPanel x:Name="PART_HeaderPanel"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"/>
                </Border>

                <!-- Data rows: vertical scroll only -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding TotalTableRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:TotalTableRowViewModel}">
                                <local:TotalTableRow/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </ScrollViewer>
    </Border>
</UserControl>
