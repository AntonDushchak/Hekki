<UserControl x:Class="Hekki.UI.Views.Race.Controls.TotalTable"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Hekki.UI.Views.Race.Controls"
             xmlns:converters="clr-namespace:Hekki.UI.Converters"
             mc:Ignorable="d"
             xmlns:vm="clr-namespace:Hekki.UI.ViewModels"
             xmlns:components="clr-namespace:Hekki.UI.Views.Race.Controls"
             xmlns:totalTableVm="clr-namespace:Hekki.UI.ViewModels.Race.TotalTable"
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <converters:ResourceKeyToStringConverter x:Key="ResourceKeyToStringConverter"/>
        <converters:ColumnHeaderConverter x:Key="ColumnHeaderConverter"/>
    </UserControl.Resources>

    <Border Background="White" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="12">
        <!-- Outer -->
        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header row -->
                <Border Grid.Row="0"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="0,0,0,1"
                        Padding="15">
                    <StackPanel x:Name="PART_HeaderPanel"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"/>
                </Border>

                <!-- Data rows -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding TotalTableRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type totalTableVm:TotalTableRowViewModel}">
                                <local:TotalTableRow/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <Grid Grid.Row="2"
                      DataContext="{Binding Participants, ElementName=Root}">
                    <Button Content="+"
                            Command="{Binding DataContext.OpenAddPilotEditorCommand, ElementName=Root}"
                            MinHeight="40">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.IsAddPilotEditorOpen, ElementName=Root}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <components:AddPilotControl>
                        <components:AddPilotControl.Style>
                            <Style TargetType="components:AddPilotControl">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.IsAddPilotEditorOpen, ElementName=Root}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </components:AddPilotControl.Style>
                    </components:AddPilotControl>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Border>
</UserControl>
