<UserControl x:Class="Hekki.UI.Views.Race.Controls.TotalTable"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:components="clr-namespace:Hekki.UI.Views.Race.Controls"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <Style x:Key="CenteredText" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="LeftText" TargetType="TextBlock">
            <Setter Property="Margin" Value="6,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <ContextMenu x:Key="RowMenu" x:Shared="False">
            <MenuItem Header="{DynamicResource m_EditPilotAction}"
                      Command="{Binding PlacementTarget.Tag.ParticipantCommands.EditPilotCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding}"/>
            <MenuItem Header="{DynamicResource m_Delete}"
                      Command="{Binding PlacementTarget.Tag.ParticipantCommands.DeleteParticipantCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding}"/>
            <MenuItem Command="{Binding PlacementTarget.Tag.ParticipantCommands.ToggleParticipantActiveCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding}">
                <MenuItem.Style>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                        <Setter Property="Header" Value="{DynamicResource m_Exclude}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                <Setter Property="Header" Value="{DynamicResource m_Include}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.Style>
            </MenuItem>
            <MenuItem Header="{DynamicResource m_OpenProfileLink}"
                      Command="{Binding PlacementTarget.Tag.ParticipantCommands.OpenProfileLinkCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding}"/>
        </ContextMenu>
    </UserControl.Resources>

    <Border Background="{DynamicResource Brush.Base}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DataGrid x:Name="PART_Grid"
                      Grid.Row="0"
                      Margin="1"
                      ItemsSource="{Binding Session.Participants}"
                      FrozenColumnCount="4"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      AllowDrop="True"
                      PreviewMouseLeftButtonDown="Grid_PreviewMouseLeftButtonDown"
                      PreviewMouseMove="Grid_PreviewMouseMove"
                      DragOver="Grid_DragOver"
                      DragLeave="Grid_DragLeave"
                      Drop="Grid_Drop">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                        <Setter Property="ContextMenu" Value="{StaticResource RowMenu}"/>
                        <Setter Property="MinHeight" Value="36"/>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="24" CanUserResize="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Tag="DragHandle" Background="Transparent" Cursor="SizeAll">
                                    <TextBlock Text="≡"
                                               FontSize="16"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource Brush.Border}"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{DynamicResource m_RowNumber}"
                                        Binding="{Binding Order}"
                                        ElementStyle="{StaticResource CenteredText}"
                                        Width="50"/>
                    <DataGridTextColumn Header="{DynamicResource m_League}"
                                        Binding="{Binding League}"
                                        ElementStyle="{StaticResource LeftText}"
                                        Width="60"/>
                    <!--<DataGridTextColumn Header="{DynamicResource m_Team}"
                                        Binding="{Binding Team}"
                                        ElementStyle="{StaticResource LeftText}"
                                        Width="100"/>-->
                    <!--<DataGridTemplateColumn Width="40">
                        TODO: photo cell
                    </DataGridTemplateColumn>-->
                    <DataGridTemplateColumn Header="{DynamicResource m_Pilot}" Width="180">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Margin="6,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding FullName}"/>
                                    <TextBlock Text="{Binding KartNumbers}" FontSize="11"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <Grid Grid.Row="1"
                  DataContext="{Binding Participants}">
                <Button Content="+"
                        Command="{Binding OpenAddPilotEditorCommand}"
                        MinHeight="40">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAddPilotEditorOpen}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <components:AddPilotControl>
                    <components:AddPilotControl.Style>
                        <Style TargetType="components:AddPilotControl">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAddPilotEditorOpen}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </components:AddPilotControl.Style>
                </components:AddPilotControl>
            </Grid>
        </Grid>
    </Border>
</UserControl>
