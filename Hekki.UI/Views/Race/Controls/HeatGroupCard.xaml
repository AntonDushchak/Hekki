<UserControl x:Class="Hekki.UI.Views.Race.Controls.HeatGroupCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="clr-namespace:Hekki.UI.Views.Shared"
             xmlns:behaviors="clr-namespace:Hekki.UI.Views.Shared.Behaviors"
             xmlns:converters="clr-namespace:Hekki.UI.Converters"
             xmlns:race="clr-namespace:Hekki.UI.Views.Race"
             xmlns:dto="clr-namespace:Hekki.Application.DTOs.Race;assembly=Hekki.Application">

    <UserControl.Resources>
        <shared:BindingProxy x:Key="Group" Data="{Binding}"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style x:Key="CenteredText" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ResultBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceMid}"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="IsEnabled" Value="{Binding HasParticipant}"/>
            <Setter Property="behaviors:ResultEditor.SaveCommand"
                    Value="{Binding DataContext.HeatActions.SaveResultCommand, RelativeSource={RelativeSource AncestorType={x:Type race:RaceView}}}"/>
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="ToolTip" Value="{Binding (Validation.Errors)/ErrorContent, RelativeSource={RelativeSource Self}}"/>
                </Trigger>
                <DataTrigger Binding="{Binding HasParticipant}" Value="False">
                    <Setter Property="Background" Value="Transparent"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource Brush.Base}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="12">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="40" Background="{DynamicResource Brush.SurfaceMid}" CornerRadius="12,0,0,12">
                <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center"
                           FontWeight="SemiBold" FontSize="14"
                           Foreground="{DynamicResource Brush.TextSecondary}">
                    <Run Text="{DynamicResource m_Group}" />
                    <Run Text=" " />
                    <Run Text="{Binding GroupNumber, Mode=OneWay}" />
                    <TextBlock.LayoutTransform>
                        <RotateTransform Angle="-90"/>
                    </TextBlock.LayoutTransform>
                </TextBlock>
            </Border>

            <DataGrid Grid.Column="1"
                      Margin="12"
                      ItemsSource="{Binding Rows}"
                      IsReadOnly="True"
                      BorderThickness="0"
                      AlternatingRowBackground="{DynamicResource Brush.Base}"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserSortColumns="False"
                      CanUserReorderColumns="False"
                      SelectionMode="Single"
                      SelectionUnit="Cell"
                      HeadersVisibility="Column"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Disabled">
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="IsTabStop" Value="False"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{DynamicResource m_GridPosition}"
                                        Binding="{Binding GridPosition}"
                                        ElementStyle="{StaticResource CenteredText}"
                                        Width="60"/>
                    <DataGridTextColumn Header="{DynamicResource m_Kart}"
                                        Binding="{Binding KartNumber}"
                                        ElementStyle="{StaticResource CenteredText}"
                                        Width="60"/>
                    <DataGridTextColumn Header="{DynamicResource m_Pilot}"
                                        Binding="{Binding Participant.FullName}"
                                        Width="180"/>
                    <!--<DataGridTemplateColumn Header="{DynamicResource m_FinishPosition}" Width="60">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Style="{StaticResource ResultBox}"
                                         Text="{Binding FinishPosition, Mode=OneWay}"
                                         behaviors:InputFilter.Kind="Integer"
                                         behaviors:ResultEditor.Field="{x:Static dto:HeatResultField.FinishPosition}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>-->
                    <DataGridTemplateColumn Header="{DynamicResource m_Time}"
                                            Width="90"
                                            Visibility="{Binding Data.Heat.ShowTime, Source={StaticResource Group}, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Style="{StaticResource ResultBox}"
                                         Text="{Binding BestLapMs, Mode=OneWay, Converter={x:Static converters:LapTimeConverter.Instance}}"
                                         behaviors:InputFilter.Kind="Time"
                                         behaviors:ResultEditor.Field="{x:Static dto:HeatResultField.BestLap}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{DynamicResource m_Score}"
                                            Width="60"
                                            Visibility="{Binding Data.Heat.ShowScore, Source={StaticResource Group}, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Style="{StaticResource ResultBox}"
                                         Text="{Binding Score, Mode=OneWay}"
                                         behaviors:InputFilter.Kind="Integer"
                                         behaviors:ResultEditor.Field="{x:Static dto:HeatResultField.Score}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{DynamicResource m_Penalty}"
                                            Width="70"
                                            Visibility="{Binding Data.Heat.ShowPenalty, Source={StaticResource Group}, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Style="{StaticResource ResultBox}"
                                         Text="{Binding Penalty, Mode=OneWay}"
                                         behaviors:InputFilter.Kind="Integer"
                                         behaviors:ResultEditor.Field="{x:Static dto:HeatResultField.Penalty}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Border>
</UserControl>
