<UserControl x:Class="Hekki.UI.Views.Race.Controls.HeatGroupCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Hekki.UI.Views.Race.Controls"
             mc:Ignorable="d"
             xmlns:table="clr-namespace:Hekki.UI.Views.Shared.Table"
             xmlns:vm="clr-namespace:Hekki.UI.ViewModels">

    <Border Background="{DynamicResource Brush.Base}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="12">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="40" Background="{DynamicResource Brush.SurfaceMid}" CornerRadius="12,0,0,12">
                <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center"
                           FontWeight="SemiBold" FontSize="14"
                           Foreground="{DynamicResource Brush.TextSecondary}">
                    <Run Text="{DynamicResource m_Group}" />
                    <Run Text=" " />
                    <Run Text="{Binding GroupNumber}" />
                    <TextBlock.LayoutTransform>
                        <RotateTransform Angle="-90"/>
                    </TextBlock.LayoutTransform>
                </TextBlock>
            </Border>

            <StackPanel Grid.Column="1" Margin="20">
                <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,5">
                    <table:TableHeader Columns="{Binding Columns}"/>
                </Border>

                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:HeatRowViewModel}">
                            <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="0,6">
                                <table:TableRow/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
