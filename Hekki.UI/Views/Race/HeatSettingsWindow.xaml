<Window x:Class="Hekki.UI.Views.Race.HeatSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shared="clr-namespace:Hekki.UI.Views.Shared.Controls"
        Title="{DynamicResource m_EditHeat}"
        Width="1000"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Style="{DynamicResource WindowStyle}">

    <Border Background="{DynamicResource Brush.Base}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="1"
            Padding="30">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="{DynamicResource m_EditHeat}"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.TextPrimary}"
                       Margin="0,0,0,10"/>

            <TextBlock Grid.Row="1"
                       Text="{DynamicResource m_HeatEditRaceOnly}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource Brush.TextSecondary}"
                       Margin="0,0,0,20"/>

            <shared:HeatSettingsEditor Grid.Row="2"
                                       DataContext="{Binding Editor}"/>

            <StackPanel Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,20,0,0">
                <Button Content="{DynamicResource m_Cancel}"
                        Command="{Binding CancelCommand}"
                        MinWidth="80"
                        Margin="0,0,10,0"/>
                <Button Content="{DynamicResource m_Save}"
                        Command="{Binding SaveCommand}"
                        MinWidth="80"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
