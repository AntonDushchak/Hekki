<UserControl x:Class="Hekki.UI.Views.Components.HeatCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Hekki.UI.Views.Components"
             mc:Ignorable="d" 
             d:DesignHeight="400" d:DesignWidth="500">
    <Border Background="White"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="1"
            CornerRadius="12">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left vertical "Group 1" label -->
            <Border Grid.Column="0"
                    Width="40"
                    Background="{DynamicResource Brush.SurfaceMid}"
                    CornerRadius="12,0,0,12">
                <TextBlock VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           FontWeight="SemiBold"
                           FontSize="14"
                           Foreground="{DynamicResource Brush.TextSecondary}">
                    <TextBlock.LayoutTransform>
                        <RotateTransform Angle="-90"/>
                    </TextBlock.LayoutTransform>
                    <TextBlock.Text>
                        <MultiBinding StringFormat="Group {0}">
                            <Binding Path="GroupNumber"/>
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </Border>

            <!-- Right content area -->
            <StackPanel Grid.Column="1" Margin="20">
                <!-- Heat name -->
                <TextBlock Text="{Binding Name}"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Margin="0,0,0,15"/>

                <!-- Table header -->
                <Border BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="0,0,0,1"
                        Padding="0,0,0,10"
                        Margin="0,0,0,5">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Pos" FontWeight="Bold" Width="60"/>
                        <TextBlock Text="Kart" FontWeight="Bold" Width="80"/>
                        <TextBlock Text="Pilot" FontWeight="Bold" Width="180"/>

                        <!-- Dynamic column headers -->
                        <ItemsControl ItemsSource="{Binding DynamicColumns}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" 
                                               FontWeight="Bold" 
                                               Width="100"
                                               TextAlignment="Right"
                                               Margin="10,0"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Results list -->
                <ItemsControl ItemsSource="{Binding Results}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource Brush.Border}"
                                    BorderThickness="0,0,0,1"
                                    Padding="0,10">
                                <StackPanel Orientation="Horizontal">
                                    <!-- Position -->
                                    <TextBlock Text="{Binding Position}" 
                                               VerticalAlignment="Center"
                                               FontSize="16"
                                               Width="60"/>

                                    <!-- Kart Number -->
                                    <Border Background="{DynamicResource Brush.SurfaceMid}"
                                            CornerRadius="4"
                                            Padding="8,4"
                                            Width="70"
                                            Margin="0,0,10,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding KartNumber}" 
                                                   FontWeight="SemiBold"
                                                   FontSize="14"
                                                   HorizontalAlignment="Center"/>
                                    </Border>

                                    <!-- Pilot Name -->
                                    <TextBlock Text="{Binding PilotName}" 
                                               VerticalAlignment="Center"
                                               FontSize="16"
                                               Width="180"/>

                                    <!-- Dynamic data -->
                                    <ItemsControl ItemsSource="{Binding DynamicData}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" 
                                                           VerticalAlignment="Center"
                                                           FontSize="16"
                                                           Width="100"
                                                           TextAlignment="Right"
                                                           Margin="10,0"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
