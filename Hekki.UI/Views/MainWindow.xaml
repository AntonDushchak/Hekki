<Window x:Class="Hekki.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Hekki.UI"
        xmlns:views="clr-namespace:Hekki.UI.Views"
        mc:Ignorable="d"
        Title="Hekki" Height="450" Width="800"
        MinHeight="450"
        MinWidth="800">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <views:TopPanel Grid.Row="0"
                        DataContext="{Binding TopPanelVM}" />

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">
            <ContentControl Content="{Binding CurrentPageVM}" />
        </ScrollViewer>
    </Grid>
</Window>
