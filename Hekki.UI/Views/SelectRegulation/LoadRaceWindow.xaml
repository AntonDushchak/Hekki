<Window x:Class="Hekki.UI.Views.SelectRegulation.LoadRaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource m_LoadRace}"
        Width="520"
        MaxHeight="640"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Style="{DynamicResource WindowStyle}">

    <Border Background="{DynamicResource Brush.Base}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="1"
            Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="{DynamicResource m_RecentRaces}"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Margin="0,0,0,16"/>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Races}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    HorizontalContentAlignment="Left"
                                    Padding="12,8"
                                    Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="{Binding RaceName}"
                                               FontSize="15"
                                               FontWeight="SemiBold"/>
                                    <TextBlock FontSize="12"
                                               Margin="0,2,0,0"
                                               Foreground="{DynamicResource Brush.TextSecondary}">
                                        <Run Text="{Binding Date, Mode=OneWay, StringFormat='{}{0:dd.MM.yyyy}'}"/>
                                        <Run Text="•"/>
                                        <Run Text="{Binding Location, Mode=OneWay}"/>
                                        <Run Text="•"/>
                                        <Run Text="{Binding RegulationName, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock Grid.Row="1"
                       Text="{DynamicResource m_NoRecentRaces}"
                       Foreground="{DynamicResource Brush.TextSecondary}"
                       Margin="0,8">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasRaces}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <Button Grid.Row="2"
                    Content="{DynamicResource m_Cancel}"
                    Command="{Binding CancelCommand}"
                    IsCancel="True"
                    MinWidth="80"
                    Margin="0,16,0,0"
                    HorizontalAlignment="Right"/>
        </Grid>
    </Border>
</Window>
