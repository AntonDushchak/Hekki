<UserControl x:Class="Hekki.UI.Views.SelectRegulation.RegulationBigList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:components="clr-namespace:Hekki.UI.Views.SelectRegulation"
             mc:Ignorable="d"
             x:Name="Root" >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,20,0,15">
            <TextBlock Text="{DynamicResource m_Regulations}" 
                       FontSize="19" FontWeight="Bold" 
                       VerticalAlignment="Center"/>
            <Button Content="{DynamicResource m_New}" 
                    HorizontalAlignment="Right" 
                    FontSize="18"
                    Command="{Binding NavigateToCreationCommand}"
                    MinWidth="55" MinHeight="30"/>
        </Grid>


        <ScrollViewer Grid.Row="1"
              VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding PagedRegulations}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Top"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource CardButtonStyle}"
                                Command="{Binding DataContext.NavigateToRaceCommand, Source={x:Reference Root}}"
                                CommandParameter="{Binding}">
                            <components:RegulationCard />
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{DynamicResource m_Delete}"
                                              Command="{Binding DataContext.DeleteRegulationCommand,
                                                                Source={x:Reference Root}}"
                                              CommandParameter="{Binding PlacementTarget.DataContext,
                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>


        <Grid Grid.Row="2" Margin="0,10,0,20">
            <TextBlock Text="{Binding PaginationService.PagingText}" 
               VerticalAlignment="Center" FontSize="14"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{DynamicResource m_Prev}" Margin="0,0,10,0" 
                Command="{Binding PrevCommand}" FontSize="18" MinWidth="55" MinHeight="30"/>
                <Button Content="{DynamicResource m_Next}" 
                Command="{Binding NextCommand}" FontSize="18" MinWidth="55" MinHeight="30"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
