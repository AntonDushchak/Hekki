<UserControl x:Class="Hekki.UI.Views.CreateRaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Hekki.UI.Views"
             xmlns:converters="clr-namespace:Hekki.UI.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <converters:IntToVisibilityConverter x:Key="IntToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid HorizontalAlignment="Stretch" 
          MaxWidth="1200" 
          Margin="40,0">
        
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="{DynamicResource m_RegulationName}" 
                       Margin="10,10,10,10" 
                       Grid.Row="0" Grid.Column="0"/>
            
            <TextBox x:Name="NameTextBox" 
                     TextWrapping="Wrap" 
                     Text="{Binding RegulationName, UpdateSourceTrigger=PropertyChanged}" 
                     Margin="10,0,10,0"
                     Grid.Row="1" Grid.Column="0"/>
        </Grid>



        <Grid Grid.Row="1" x:Name="HeatsGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="{DynamicResource m_Heats}" 
                       HorizontalAlignment="Left" 
                       Margin="10,0,10,10" 
                       VerticalAlignment="Top"
                       Grid.Row="0"/>

            <ListBox ItemsSource="{Binding Heats}" 
                     SelectedItem="{Binding SelectedHeat}" 
                     Grid.Row="1"
                     Grid.ColumnSpan="2"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     Visibility="{Binding Heats.Count, Converter={StaticResource IntToVisibilityConverter}}">

                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="2,0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="InnerBorder" 
                                            CornerRadius="2" 
                                            Padding="12,6">
                                        <ContentPresenter Content="{Binding Name}" 
                                              HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <Button x:Name="AddHeatButton"
                    Content="{DynamicResource m_AddHeat}" 
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Top" 
                    MinWidth="55" MinHeight="30"
                    Command="{Binding AddHeatCommand}"
                    Grid.Row="2"/>
        </Grid>

        <Border x:Name="HeatDetails" 
                CornerRadius="8" 
                Padding="20"
                Grid.Column="1" Grid.Row="2" Grid.RowSpan="2"
                Visibility="{Binding SelectedHeat, Converter={StaticResource NullToVisibilityConverter}}">

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Grid Margin="0,0,0,20">
                        <TextBlock Text="{DynamicResource m_HeatDetails}" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding SelectedHeat.Name}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource m_Name}" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding SelectedHeat.Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,15"/>

                            <TextBlock Text="{DynamicResource m_GroupsCount}" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding SelectedHeat.NumberOfGroups, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,15"/>

                            <TextBlock Text="{DynamicResource m_GroupCapacity}" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding SelectedHeat.GroupCapacity, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,15"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{DynamicResource m_KartAssignment}" Margin="0,0,0,5"/>
                            <ComboBox SelectedValue="{Binding SelectedHeat.KartAssignment.MethodId}" 
                              DisplayMemberPath="Title"
                              SelectedValuePath="Id"
                              ItemsSource="{Binding AvailableKartMethods}"
                              Margin="0,0,0,15"/>

                            <TextBlock Text="{DynamicResource m_ScoringSystem}" Margin="0,0,0,5"/>
                            <ComboBox SelectedValue="{Binding SelectedHeat.Scoring.MethodId}" 
                              DisplayMemberPath="Title"
                              SelectedValuePath="Id"
                              ItemsSource="{Binding AvailableScoreMethods}"/>

                            <TextBlock Text="{DynamicResource m_ShuffleSystem}" Margin="0,0,0,5"/>
                            <ComboBox SelectedValue="{Binding SelectedHeat.Shuffle.MethodId}" 
                                      DisplayMemberPath="Title"
                                      SelectedValuePath="Id"
                                      ItemsSource="{Binding AvailableShuffleMethods}"
                                      Margin="0,0,0,15"/>

                            <TextBlock Text="{DynamicResource m_GroupAssignment}" Margin="0,0,0,5"/>
                            <ComboBox SelectedValue="{Binding SelectedHeat.Grouping.MethodId}"
                                      DisplayMemberPath="Title"
                                      SelectedValuePath="Id"
                                      ItemsSource="{Binding AvailableGroupMethods}"/>
                        </StackPanel>
                    </Grid>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <Button x:Name="SaveButton" 
        Command="{Binding SaveCommand}" 
        Content="{DynamicResource m_Save}" 
        MinWidth="55" MinHeight="30"
        HorizontalAlignment="Right"
        Grid.Row="3"
        Margin="20"/>
        
        <CheckBox x:Name="SameScoreCheckBox" 
                  Content="{DynamicResource m_SameScores}" 
                  HorizontalAlignment="Left" 
                  VerticalAlignment="Bottom" 
                  Grid.Row="3"/>
        
    </Grid>
</UserControl>
