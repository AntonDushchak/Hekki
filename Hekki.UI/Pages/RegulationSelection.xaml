<Page x:Class="Hekki.UI.Pages.RegulationSelection"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Hekki.UI.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="RegulationSelection">

    <Grid>
        <Label Content="Selection" HorizontalAlignment="Left" Margin="278,0,0,0" VerticalAlignment="Center" FontSize="48"/>
        <ComboBox x:Name="RegulationComboBox" 
                  ItemsSource="{Binding Items}" 
                  DisplayMemberPath="Title"
                  SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                  HorizontalAlignment="Left" 
                  Margin="10,10,0,0" 
                  VerticalAlignment="Top" 
                  Width="150">

        </ComboBox>
    </Grid>
</Page>
