<Page x:Class="Hekki.UI.Pages.RegulationShell"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Hekki.UI.Pages"
      xmlns:controls="clr-namespace:Hekki.UI.Controls"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="RegulationShell">

    <Grid>
        <controls:RegulationPicker x:Name="RegulationPicker" DataContext="{Binding RegulationSelectionViewModel}" />
        <Frame x:Name="RegulationMainFrame" NavigationUIVisibility="Hidden" />
    </Grid>
</Page>
