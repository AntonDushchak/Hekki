<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:Hekki.UI.ViewModels"
                    xmlns:views="clr-namespace:Hekki.UI.Views">

    <DataTemplate DataType="{x:Type vm:RaceViewModel}">
        <views:RaceView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:CreateRaceViewModel}">
        <views:CreateRaceView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:SelectionViewModel}">
        <views:SelectRaceView />
    </DataTemplate>
    

    <DataTemplate DataType="{x:Type vm:RaceTopPanelViewModel}">
        <views:RaceTopPanelView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:CreateRaceTopPanelViewModel}">
        <views:JustTextTopPanel />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:SelectionTopPanelViewModel}">
        <views:JustTextTopPanel />
    </DataTemplate>
</ResourceDictionary>