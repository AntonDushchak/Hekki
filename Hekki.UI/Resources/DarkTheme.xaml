<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Base -->
    <Color x:Key="Color.Base">#1E1E1E</Color>
    <Color x:Key="Color.SurfaceLow">#252525</Color>
    <Color x:Key="Color.SurfaceMid">#2D2D2D</Color>
    <Color x:Key="Color.SurfaceHigh">#3A3A3A</Color>
    <Color x:Key="Color.UIElement">#444444</Color>
    <Color x:Key="Color.ActionDark">#FFFFFF</Color>
    <Color x:Key="Color.Border">#5A5A5A</Color>

    <!-- Text -->
    <Color x:Key="Color.TextPrimary">#FFFFFF</Color>
    <Color x:Key="Color.TextModal">#EAEAEA</Color>
    <Color x:Key="Color.TextSecondary">#C2C2C2</Color>
    <Color x:Key="Color.TextDisabled">#8C8C8C</Color>
    <Color x:Key="Color.TextHint">#6F6F6F</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="Brush.Base" Color="{StaticResource Color.Base}"/>
    <SolidColorBrush x:Key="Brush.SurfaceLow" Color="{StaticResource Color.SurfaceLow}"/>
    <SolidColorBrush x:Key="Brush.SurfaceMid" Color="{StaticResource Color.SurfaceMid}"/>
    <SolidColorBrush x:Key="Brush.SurfaceHigh" Color="{StaticResource Color.SurfaceHigh}"/>
    <SolidColorBrush x:Key="Brush.UIElement" Color="{StaticResource Color.UIElement}"/>
    <SolidColorBrush x:Key="Brush.ActionDark" Color="{StaticResource Color.ActionDark}"/>
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}"/>

    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.TextPrimary}"/>
    <SolidColorBrush x:Key="Brush.TextModal" Color="{StaticResource Color.TextModal}"/>
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}"/>
    <SolidColorBrush x:Key="Brush.TextDisabled" Color="{StaticResource Color.TextDisabled}"/>
    <SolidColorBrush x:Key="Brush.TextHint" Color="{StaticResource Color.TextHint}"/>

</ResourceDictionary>